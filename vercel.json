{
  "version": 2,
  "installCommand": "npm install && cd server && npm install && cd .. && cd client && npm install && cd .. && cd server && npx prisma generate",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/src/**",
          "server/package.json",
          "server/prisma/**",
          "node_modules/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/client/$1"
    }
  ]
}
