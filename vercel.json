{
  "version": 2,
  "installCommand": "npm install && cd server && npx prisma generate",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/client/$1"
    }
  ]
}
