[TEMPLATE]
# Server port
PORT=5000

# JWT secret — generate a strong one with: openssl rand -hex 32
JWT_SECRET=super-secret-campusconnect-change-me
JWT_EXPIRES_IN=7d

# PostgreSQL connection string (Supabase, Neon, RDS, local…)
# e.g. DATABASE_URL=postgresql://postgres:password@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini AI — PRIMARY AI provider (free tier: 15 RPM / 1M tokens/day)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq AI — FALLBACK provider (free tier, fast)
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Comma separated list of demo admin emails (optional)
DEMO_ADMINS=

# Public base URL used in emails/links
PUBLIC_URL=http://localhost:5173
