# Server port
PORT=5000

# JWT secret — change in production
JWT_SECRET=super-secret-campusconnect-change-me
JWT_EXPIRES_IN=7d

# MongoDB: leave empty to auto-start an ephemeral demo database.
# For production set a real connection string, e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/campusconnect
MONGODB_URI=

# Google Gemini AI — leave empty to use offline deterministic fallbacks.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma separated list of demo admin emails (optional)
DEMO_ADMINS=

# Public base URL used in emails/links
PUBLIC_URL=http://localhost:5173
